# Underwater landscape built around Microsoft's canonical Khronos BarramundiFish.
# Camera and lights are inside the homogeneous water; no visible air-water interface.
LookAt .25 1.35 -3.3  0 1.2 4  0 1 0
Camera "perspective" "float fov" 55 "float shutterclose" 1
WorldBegin
Volume "homogeneous" "point3 p0" [-35 -4 -12] "point3 p1" [35 9 60] "rgb sigma_a" [.03 .007 .003] "float sigma_s" .025 "float g" .8
LightSource "infinite" "rgb L" [.12 .27 .4]
Texture "fish" "spectrum" "imagemap" "string filename" "assets/fish.ppm"
Texture "fish_tint" "spectrum" "scale" "texture tex1" "fish" "rgb tex2" [.95 .98 1]
Texture "sand" "spectrum" "imagemap" "string filename" "assets/coast_sand_01.ppm"
Texture "rock" "spectrum" "imagemap" "string filename" "assets/rocky_terrain.ppm"
Texture "kelp" "spectrum" "noise" "rgb tex1" [.035 .075 .012] "rgb tex2" [.18 .24 .035] "float scale" 4
Material "diffuse" "texture reflectance" "sand"
Shape "plymesh" "string filename" "assets/seabed.ply"
ObjectBegin "fish"
Material "coateddiffuse" "texture reflectance" "fish_tint"
Shape "plymesh" "string filename" "assets/fish.ply"
ObjectEnd
ObjectBegin "rock"
Material "diffuse" "texture reflectance" "rock"
Shape "plymesh" "string filename" "assets/reef-rock.ply"
ObjectEnd
ObjectBegin "kelp"
Material "diffuse" "texture reflectance" "kelp"
Shape "plymesh" "string filename" "assets/kelp.ply"
ObjectEnd
AttributeBegin
Translate -0.25 0.7 -0.5
Motion "rigid" "vector3 translation" [.18 .02 0] "vector3 axis" [0 1 0] "float angle" 8
Rotate 95 0 1 0
Scale 2.5 2.5 2.5
ObjectInstance "fish"
AttributeEnd
